# Local Terraform working directories
.terraform/

# State files – NEVER commit state; use a remote backend (e.g. S3 + DynamoDB)
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup

# Terraform lock file
# .terraform.lock.hcl

# Variable override files that may contain secrets
*.tfvars
*.tfvars.json

# Private keys and certificates – NEVER commit these
*.pem
*.key
*.p12
*.pfx

# IDE and OS artefacts
.DS_Store
Thumbs.db
.idea/
.vscode/

# Crash log files
crash.log
crash.*.log